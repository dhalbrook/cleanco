{
  "name": "cleanco",
  "description": "Tupescript implementation of cleanco python",
  "version": "1.0.3",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
